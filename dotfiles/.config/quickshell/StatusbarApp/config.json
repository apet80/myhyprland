/*
Default configuration file for the Quickshell Statusbar.

This file documents the built-in defaults (kept in sync with defaultSettings in
StatusbarWindow.qml). The statusbar itself reads a single file:

  ~/.config/ml4w-statusbar/config.json

It is created empty on first start and merged over
the built-in defaults below, so it only needs to carry the values you want to
change. The statusbar writes enabled / alwaysExpanded / autohide back into it.

bar.monitors controls which monitors get a bar:
  []                  - first monitor only (default)
  ["all"]              - every connected monitor
  ["DP-1", "HDMI-A-1"] - an explicit list of monitor names (see `hyprctl monitors`)

systemtray.colorize (default true) flattens every tray icon to a flat glyph in
the bar's accent color, so faint monochrome symbols like nm-applet /
firewall-applet read as clearly as the bar's own icons. Set it to false to draw
apps' real icon colors instead.
systemtray.chip (default true) draws an accent-colored plate behind the tray
in a light palette; colorized icons switch to a contrasting color on it.
systemtray.iconSize is the icon edge length in px.
*/
{
    "bar": {
        "height": 40,
        "reservedHeight": 72,
        "enabled": true,
        "alwaysExpanded": true,
        "autohide": false,
        "hideDelay": 400,
        "monitors": []
    },
    "pill": {
        "collapsedWidth": 0,
        "expandedWidth": 680,
        "radius": 12,
        "animationDuration": 350
    },
    "modules": {
        "left":   ["terminal", "workspaces"],
        "center": ["launcher", "clock", "swaync"],
        "right":  ["updates", "battery", "powerprofile", "volume", "systemtray", "logo", "power"]
    },
    "border": {
        "width": 2,
        "colorTop": "",
        "colorBottom": ""
    },
    "opacity": {
        "collapsed": 0.6,
        "expanded": 0.8
    },
    "clock": {
        "format": "HH:mm",
        "dateFormat": "ddd, dd MMM",
        "calendarCommand": ""
    },
    "volume": {
        "settingsCommand": "pavucontrol"
    },
    "workspaces": {
        "count": 5
    },
    "systemtray": {
        "chip": true,
        "iconSize": 20,
        "colorize": true
    }
}
